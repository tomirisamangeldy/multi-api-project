    <%- include('partials/header.ejs') %>

<div class="astroFacts-body bodies">
       <div class="title-card">
         <h2>Bodies of our Solar System</h2>
    <p>Gain new technical knowledge about a planet, moon or asteroid in our own Solar System by clicking the "Random" button or search by name</p>
       </div>
    <hr>
    <div class="astroFacts-data">
            <div class="astroFacts-input">

<form class = "btn-random-solar" action="/astroFacts" method="get"><input type="submit" value="Random"></form>

        </div>
        <div class="astroFacts-output">
            <h3>
            <% if(details.englishName === null || details.englishName === ""){ %>
                <%= details.name  %>
                <% }else{ %>
             <%= details.englishName %>
             <% } %>
            
            </h3>
        
            <hr>
            <p>
                <%const exclude = ["id", "rel"];%>

<ul>
  <% Object.entries(details).forEach(([key, value]) => { %>

    <% if (exclude.includes(key)) return; %>
    <% if (value === null || value === "" || value == 0) return; %>

    <li>
      <strong><%= key %>:</strong>

      <% if (key === "aroundPlanet" && value) { %>
        <%= value.planet %>

      <% } else if (key === "mass" && value) { %>
        <%= value.massValue %>
      <%}else if (key === "volume" && value) { %>
        <%= value.volValue %>
      <%}else if (typeof value === "object") { %>
        <%= JSON.stringify(value) %>

      <% } else { %>
        <%= value %>
      <% } %>

    </li>

  <% }) %>
</ul>
            </p>
        </div>
    </div>
</div>
    
     <%- include('partials/footer.ejs') %>